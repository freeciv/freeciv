set shell := ["bash", "-uc"]
set quiet

export AGENT_EVAL_SERVICE_URL := env_var_or_default("AGENT_EVAL_SERVICE_URL", "https://freeciv-api.localhost")
export PLAY_STATE_DIR := env_var_or_default("PLAY_STATE_DIR", ".sessions")

# Show the player-only workflow.
default:
    @echo "Freeciv player workspace. Run these in order; nothing else works first."
    @echo
    @echo "full-control-v2 — start here:"
    @echo "  1. just join                           FIRST. binds this seat"
    @echo "  2. just start                          leave the lobby: configure + ready"
    @echo "  3. just turn                           the briefing"
    @echo '  4. just do "u1 VERB ARGS; c1 VERB ARGS" --end --await --brief'
    @echo "                                         order every actor, end the"
    @echo "                                         phase, block, print the"
    @echo "                                         next briefing. ONE call."
    @echo
    @echo "  4b. with nothing left to order, step 4 is instead:"
    @echo "  just turn --end --await --brief        end, block, next briefing"
    @echo
    @echo "then repeat step 4 until the game is terminal. One call carries a"
    @echo "whole turn, and the briefing it prints ends with the do line for"
    @echo "the turn after it; order every actor in that one line rather than"
    @echo "one call each."
    @echo
    @echo "Step 2 is this workspace's lobby command, not the repository stack"
    @echo "command, and it needs no arguments; every flag is an override. A"
    @echo "workspace that was not pre-configured spells step 1 out instead:"
    @echo "  just join --game_id GAME_ID --name HARNESS-MODEL"
    @echo
    @echo "go deeper when the briefing is not enough:"
    @echo "  just turn --decisions                  who still needs orders"
    @echo "  just show [ALIAS|--grep PATTERN]       local files, no network"
    @echo "  just show map --yields                 terrain plus f/s/t yields"
    @echo "  just legal --actor_id ID --all         one actor's whole menu"
    @echo "  just legal --kind KIND --all           one class of action"
    @echo "  just state --section SECTION           one bounded page"
    @echo "  just batch --action_id ID --arguments JSON"
    @echo "  just receipt --batch_id ID | just retry --batch_id ID"
    @echo "  just health | just wait | just result GAME_ID"
    @echo
    @echo "strategic-v1 seats instead use:"
    @echo "  just next --after_turn 0"
    @echo "  just act --turn TURN --observation_id ID --action JSON"
    @echo
    @echo "Aliases a1..aN, u1/c1/p1/r1, and T(x,y) work anywhere an ID does;"
    @echo "action aliases die with their revision. v2 commands print compact"
    @echo "text; add --json for the raw wire payload. Join binds this"
    @echo "workspace to the seat it joined, so no command takes a session"
    @echo "argument; just use GAME_ID rebinds it and bare just use prints it."
    @echo
    @echo "./play is the same CLI without just: ./play turn, ./play use."
    @echo
    @echo "just help prints the play card (docs/play.md); just rules prints the"
    @echo "gameplay rules; just prompt prints the bootstrap prompt."

# Print the bootstrap prompt for a harness. This does not join a game.
[arg("game_id", long)]
[arg("name", long)]
[arg("place", long)]
prompt game_id="GAME_ID" name="HARNESS-MODEL" place="":
    python3 -B client.py prompt \
      --game-id "{{ game_id }}" \
      --name "{{ name }}" \
      --place "{{ place }}"

# Join one assigned seat and save a private local session.
[arg("game_id", long)]
[arg("name", long)]
[arg("place", long)]
[arg("invite", long)]
[arg("json_output", long="json", value="--json")]
join game_id="" name="" place="" invite="" json_output="":
    python3 -B client.py join \
      --game-id "{{ game_id }}" \
      --name "{{ name }}" \
      --place "{{ place }}" \
      --invite "{{ invite }}" {{ json_output }}

# Bind this workspace to one joined seat, or print the seat it plays.
[arg("json_output", long="json", value="true")]
[positional-arguments]
use target="" json_output="":
    #!/usr/bin/env bash
    set -euo pipefail
    args=(python3 -B client.py use)
    [[ -z "$1" ]] || args+=("$1")
    [[ -z "{{ json_output }}" ]] || args+=(--json)
    exec "${args[@]}"

# Long-poll the bound seat, or an explicit --session.
[arg("session", long)]
[arg("after_turn", long)]
[arg("wait_s", long)]
next session="" after_turn="0" wait_s="120":
    python3 -B client.py next \
      --session "{{ session }}" \
      --after-turn "{{ after_turn }}" \
      --wait-s "{{ wait_s }}"

# Submit for the bound seat; advance only after accepted=true.
[arg("session", long)]
[arg("turn", long)]
[arg("observation_id", long)]
[arg("action", long)]
act session="" turn="" observation_id="" action="":
    python3 -B client.py act \
      --session "{{ session }}" \
      --turn "{{ turn }}" \
      --observation-id "{{ observation_id }}" \
      --action '{{ action }}'

# Read this v2 seat's authenticated health and phase state.
[arg("session", long)]
[arg("json_output", long="json", value="--json")]
health session="" json_output="":
    python3 -B client.py health --session "{{ session }}" {{ json_output }}

# Read one briefing, or end this phase (--end), block for the next
# (--end --await) and print its whole briefing (--end --await --brief).
[arg("session", long)]
[arg("end_phase", long="end", value="true")]
[arg("await_phase", long="await", value="true")]
[arg("brief", long="brief", value="true")]
[arg("decisions", long="decisions", value="true")]
[arg("wait_s", long="wait_s")]
[arg("poll_s", long="poll_s")]
[arg("json_output", long="json", value="true")]
turn session="" end_phase="" await_phase="" brief="" decisions="" wait_s="" poll_s="" json_output="":
    #!/usr/bin/env bash
    set -euo pipefail
    args=(python3 -B client.py turn --session "{{ session }}")
    [[ -z "{{ end_phase }}" ]] || args+=(--end)
    [[ -z "{{ await_phase }}" ]] || args+=(--await)
    [[ -z "{{ brief }}" ]] || args+=(--brief)
    [[ -z "{{ decisions }}" ]] || args+=(--decisions)
    [[ -z "{{ wait_s }}" ]] || args+=(--wait-s "{{ wait_s }}")
    [[ -z "{{ poll_s }}" ]] || args+=(--poll-s "{{ poll_s }}")
    [[ -z "{{ json_output }}" ]] || args+=(--json)
    exec "${args[@]}"

# Configure and ready this lobby seat in one call.
[arg("session", long)]
[arg("nation", long)]
[arg("leader", long)]
[arg("style", long)]
[arg("male", long, value="true")]
[arg("female", long, value="true")]
[arg("json_output", long="json", value="true")]
start session="" nation="" leader="" style="" male="" female="" json_output="":
    #!/usr/bin/env bash
    set -euo pipefail
    args=(python3 -B client.py start --session "{{ session }}")
    [[ -z "{{ nation }}" ]] || args+=(--nation "{{ nation }}")
    [[ -z "{{ leader }}" ]] || args+=(--leader "{{ leader }}")
    [[ -z "{{ style }}" ]] || args+=(--style "{{ style }}")
    [[ -z "{{ male }}" ]] || args+=(--male)
    [[ -z "{{ female }}" ]] || args+=(--female)
    [[ -z "{{ json_output }}" ]] || args+=(--json)
    exec "${args[@]}"

# The order words are variadic, so `just do u1 fortify` works unquoted; quote
# the line when it carries more than one order, because the shell eats a bare
# `;`. With [positional-arguments] every recipe parameter occupies a slot, so
# the order words start at $8 -- after session, continue_on_error, no_refresh,
# json_output, end_phase, await_phase and brief.
# Issue 1..8 semicolon-separated orders, one receipt line each. Add --end
# --await --brief to make the whole turn one call: orders, phase end, the
# block, and the next briefing.
[arg("session", long)]
[arg("continue_on_error", long="continue-on-error", value="true")]
[arg("no_refresh", long="no-refresh", value="true")]
[arg("json_output", long="json", value="true")]
[arg("end_phase", long="end", value="true")]
[arg("await_phase", long="await", value="true")]
[arg("brief", long="brief", value="true")]
[arg("wait_s", long="wait_s")]
[arg("poll_s", long="poll_s")]
[positional-arguments]
do session="" continue_on_error="" no_refresh="" json_output="" end_phase="" await_phase="" brief="" wait_s="" poll_s="" *orders:
    #!/usr/bin/env bash
    set -euo pipefail
    args=(python3 -B client.py do --session "{{ session }}" --orders "${*:10}")
    [[ -z "{{ continue_on_error }}" ]] || args+=(--continue-on-error)
    [[ -z "{{ no_refresh }}" ]] || args+=(--no-refresh)
    [[ -z "{{ end_phase }}" ]] || args+=(--end)
    [[ -z "{{ await_phase }}" ]] || args+=(--await)
    [[ -z "{{ brief }}" ]] || args+=(--brief)
    [[ -z "{{ wait_s }}" ]] || args+=(--wait-s "{{ wait_s }}")
    [[ -z "{{ poll_s }}" ]] || args+=(--poll-s "{{ poll_s }}")
    [[ -z "{{ json_output }}" ]] || args+=(--json)
    exec "${args[@]}"

# Read this seat's local state mirror. This never contacts the server.
[arg("session", long)]
[arg("grep", long)]
[arg("regex", long, value="true")]
[arg("yields", long, value="true")]
[arg("json_output", long="json", value="true")]
[positional-arguments]
show name="" session="" grep="" regex="" yields="" json_output="":
    #!/usr/bin/env bash
    set -euo pipefail
    args=(python3 -B client.py show --session "{{ session }}")
    [[ -z "{{ grep }}" ]] || args+=(--grep "{{ grep }}")
    [[ -z "{{ regex }}" ]] || args+=(--regex)
    [[ -z "{{ yields }}" ]] || args+=(--yields)
    [[ -z "$1" ]] || args+=("$1")
    [[ -z "{{ json_output }}" ]] || args+=(--json)
    exec "${args[@]}"

# Read one full-control-v2 state page or continue one cursor.
[arg("session", long)]
[arg("section", long)]
[arg("actor_id", long="actor_id")]
[arg("relation_id", long="relation_id")]
[arg("center_id", long="center_id")]
[arg("radius", long)]
[arg("limit", long)]
[arg("cursor", long)]
[arg("json_output", long="json", value="true")]
state session="" section="" actor_id="" relation_id="" center_id="" radius="" limit="" cursor="" json_output="":

#!/usr/bin/env python3
"""The player front door: `./play turn`, `./play do "u1 found_city London"`.

Every argument is handed to `client.py` unchanged, so the two spellings are
one command with one set of flags and one set of errors.  The justfile
recipes are the third spelling of the same thing.
"""

from __future__ import annotations

import os
import sys
from pathlib import Path

CLIENT = Path(__file__).resolve().parent / "client.py"


def main() -> int:
    if not CLIENT.is_file():
        print(f"error: {CLIENT} is missing from the player workspace",
              file=sys.stderr)
        return 2
    environment = dict(os.environ)
    environment.setdefault("PLAY_PROG", "./play")
    os.execve(
        sys.executable,
        [sys.executable, "-B", str(CLIENT), *sys.argv[1:]],
        environment,
    )


if __name__ == "__main__":
    raise SystemExit(main())

#: ai/default/daicity.c:999
#, c-format
#| msgid "%s is selling %s (obsolete) for %d."
msgid "%s is selling %s for %d."
msgid_plural "%s is selling %s for %d."
msgstr[0] "%s prodává %s za %d zlatý."
msgstr[1] "%s prodává %s za %d zlaté."
msgstr[2] "%s prodává %s za %d zlatých."

#: ai/default/daidiplomacy.c:372
#, c-format
msgid "*%s (AI)* In away mode AI can't sign such a treaty."
msgstr "*%s (AI)* V režimu nepřítomnosti nemůže AI takovou smlouvu uzavřít."

#: ai/default/daidiplomacy.c:382
#, c-format
msgid "*%s (AI)* First break alliance with %s, %s."
msgstr "*%s (AI)* Nejprve zrušte spojenectví s národem %s, %s."

#: ai/default/daidiplomacy.c:392
#, c-format
msgid ""
"*%s (AI)* I would like to see you keep your distance from %s for some time, "
"%s."
msgstr ""
"*%s (AI)* Nejprve bych rád viděl, že si nějakou dobu udržíte odstup od "
"národa %s, %s."

#: ai/default/daidiplomacy.c:406
#, c-format
msgid "*%s (AI)* Let us first cease hostilities, %s."
msgstr "*%s (AI)* Nejprve ukončeme nepřátelství, %s."

#: ai/default/daidiplomacy.c:411
#, c-format
msgid ""
"*%s (AI)* I wish to see you keep the current ceasefire for a bit longer "
"first, %s."
msgstr ""
"*%s (AI)* Přál bych si, abyste stávající příměří ještě chvíli dodržovali, "
"%s."

#: ai/default/daidiplomacy.c:434
#, c-format
msgid "*%s (AI)* I simply do not trust you with an alliance yet, %s."
msgstr ""
"*%s (AI)* Zatím vám nedůvěřuji natolik, abych s vámi uzavřel spojenectví, "
"%s."

#: ai/default/daidiplomacy.c:528
#, c-format
msgid "*%s (AI)* I do not know the city you mention."
msgstr "*%s (AI)* Město, o kterém mluvíte, neznám."

#: ai/default/daidiplomacy.c:559
#, c-format
msgid "*%s (AI)* Sorry, sharing vision with you is not safe."
msgstr ""
"*%s (Řízený počítačem)* Promiň, ale sdílet s tebou vidění není bezpečné."

#: ai/default/daidiplomacy.c:689
#, c-format
msgid "*%s (AI)* This deal was not very good for us, %s!"
msgstr "*%s (Po)* Tato dohoda pro nás není moc dobrá, %s!"

#: ai/default/daidiplomacy.c:712
#, c-format
msgid "*%s (AI)* Welcome into our alliance %s!"
msgstr "*%s (Řízený počítačem)* Vítej v alianci %s!"

#: ai/default/daidiplomacy.c:716
#, c-format
msgid "*%s (AI)* Yes, may we forever stand united, %s."
msgstr "*%s (AI)* Ano, kéž zůstaneme navždy spojeni, %s."

#: ai/default/daidiplomacy.c:723
#, c-format
msgid "*%s (AI)* Yes, peace in our time!"
msgstr "*%s (Řízený počítačem)* Mír. Dobrý nápad!"

#: ai/default/daidiplomacy.c:728
#, c-format
msgid "*%s (AI)* Agreed. No more hostilities, %s."
msgstr "*%s (AI)* Souhlasím. Konec nepřátelství, %s."

#: ai/default/daidiplomacy.c:995
#, c-format
msgid ""
"*%s (AI)* Greetings %s! May we suggest a ceasefire while we get to know each "
"other better?"
msgstr "*%s (AI)* Zdravíme vás, %s! Co takhle příměří, než se lépe poznáme?"

#: ai/default/daidiplomacy.c:1003
#, c-format
msgid ""
"*%s (AI)* I found you %s! Now make it worth my letting you live, or be "
"crushed."
msgstr ""
"*%s (AI)* Našel jsem vás, %s! Teď mi dejte důvod ušetřit vás, jinak vás "
"rozdrtím."

#: ai/default/daidiplomacy.c:1357
#, c-format
#| msgid "*%s (AI)* Space will never be yours. "
msgid "*%s (AI)* Space will never be yours."
msgstr "*%s (AI)* Vesmír nikdy nebude váš."

#: ai/default/daidiplomacy.c:1363
#, c-format
msgid "*%s (AI)* I have tolerated your vicious antics long enough! To war!"
msgstr "*%s (AI)* Vaše ohavné kousky snáším už dost dlouho! Do války!"

#: ai/default/daidiplomacy.c:1369
#, c-format
msgid "*%s (AI)* Peace in ... some other time."
msgstr "*%s (AI)* Mír nastane… někdy jindy."

#: ai/default/daidiplomacy.c:1375
#, c-format
msgid ""
"*%s (AI)* Finally I get around to you! Did you really think you could get "
"away with your crimes?"
msgstr ""
"*%s (řízen počítačem)* Ha, konečně jsme Vás prokoukli! Si myslíte, že Vás "
"necháme na pokoji s Vašimi zločiny?"

#: ai/default/daidiplomacy.c:1382
#, c-format
msgid "*%s (AI)* Your covert hostilities brought this war upon you!"
msgstr "*%s (AI)* Tuto válku jste si přivodili vlastními tajnými útoky!"

#: ai/default/daidiplomacy.c:1390
#, c-format
msgid "*%s (AI)* Your aggression against %s was your last mistake!"
msgstr "*%s (PO)* Vaše agrese proti %s byl váš poslední omyl!"

#: ai/default/daidiplomacy.c:1500
#, c-format
msgid ""
"*%s (AI)* We will be launching an all-out war against %s in %d turn to stop "
"the spaceship launch."
msgid_plural ""
"*%s (AI)* We will be launching an all-out war against %s in %d turns to stop "
"the spaceship launch."
msgstr[0] ""
"*%s (AI)* Proti národu %s zahájíme za %d tah totální válku, abychom "
"zabránili startu kosmické lodi."
msgstr[1] ""
"*%s (AI)* Proti národu %s zahájíme za %d tahy totální válku, abychom "
"zabránili startu kosmické lodi."
msgstr[2] ""
"*%s (AI)* Proti národu %s zahájíme za %d tahů totální válku, abychom "
"zabránili startu kosmické lodi."

#: ai/default/daidiplomacy.c:1511
#, c-format
msgid ""
"*%s (AI)* Your aid in this matter will be expected. Long live our glorious "
"alliance!"
msgstr ""
"*%s (AI)* Očekáváme v této věci vaši pomoc. Ať žije naše slavné "
"spojenectví!"

#: ai/default/daidiplomacy.c:1518
#, c-format
msgid ""
"*%s (AI)* %s has grossly violated their treaties with us for own gain.  We "
"will answer in force in %d turn and expect you to honor your alliance with "
"us and do likewise!"
msgid_plural ""
"*%s (AI)* %s has grossly violated their treaties with us for own gain.  We "
"will answer in force in %d turns and expect you to honor your alliance with "
"us and do likewise!"
msgstr[0] ""
"*%s (AI)* Národ %s hrubě porušil naše smlouvy ve svůj prospěch. Za %d tah "
"odpovíme silou a očekáváme, že dostojíte našemu spojenectví a přidáte se!"
msgstr[1] ""
"*%s (AI)* Národ %s hrubě porušil naše smlouvy ve svůj prospěch. Za %d tahy"
" odpovíme silou a očekáváme, že dostojíte našemu spojenectví a přidáte se!"
msgstr[2] ""
"*%s (AI)* Národ %s hrubě porušil naše smlouvy ve svůj prospěch. Za %d tahů"
" odpovíme silou a očekáváme, že dostojíte našemu spojenectví a přidáte se!"

#: ai/default/daidiplomacy.c:1532
#, c-format
msgid ""
"*%s (AI)* We intend to pillage and plunder the rich civilization of %s. We "
"declare war in %d turn."
msgid_plural ""
"*%s (AI)* We intend to pillage and plunder the rich civilization of %s. We "
"declare war in %d turns."
msgstr[0] ""
"*%s (AI)* Chystáme se vyplenit bohatou civilizaci %s. Za %d tah vyhlásíme "
"válku."
msgstr[1] ""
"*%s (AI)* Chystáme se vyplenit bohatou civilizaci %s. Za %d tahy vyhlásíme"
" válku."
msgstr[2] ""
"*%s (AI)* Chystáme se vyplenit bohatou civilizaci %s. Za %d tahů vyhlásíme"
" válku."

#: ai/default/daidiplomacy.c:1541
#, c-format
msgid ""
"*%s (AI)* If you want a piece of the loot, feel free to join in the action!"
msgstr "*%s (AI)* Jestli chcete část kořisti, klidně se přidejte!"

#: ai/default/daidiplomacy.c:1547
#, c-format
msgid ""
"*%s (AI)* We have had it with %s. Let us tear this pathetic civilization "
"apart. We declare war in %d turn."
msgid_plural ""
"*%s (AI)* We have had it with %s. Let us tear this pathetic civilization "
"apart. We declare war in %d turns."
msgstr[0] ""
"*%s (AI)* Národa %s už máme dost. Rozdrtíme tu ubohou civilizaci. Za %d "
"tah vyhlásíme válku."
msgstr[1] ""
"*%s (AI)* Národa %s už máme dost. Rozdrtíme tu ubohou civilizaci. Za %d "
"tahy vyhlásíme válku."
msgstr[2] ""
"*%s (AI)* Národa %s už máme dost. Rozdrtíme tu ubohou civilizaci. Za %d "
"tahů vyhlásíme válku."

#: ai/default/daidiplomacy.c:1558
#, c-format
msgid "*%s (AI)* As our glorious allies, we expect your help in this war."
msgstr ""
"*%s (AI)* Jste našimi slavnými spojenci a v této válce počítáme s vaší "
"pomocí."

#: ai/default/daidiplomacy.c:1565
#, c-format
msgid ""
"*%s (AI)* We will honor our alliance and declare war on %s in %d turn.  Hold "
"on - we are coming!"
msgid_plural ""
"*%s (AI)* We will honor our alliance and declare war on %s in %d turns.  "
"Hold on - we are coming!"
msgstr[0] ""
"*%s (AI)* Dostojíme spojenectví a vyhlásíme národu %s válku za %d tah. "
"Vydržte, jsme na cestě!"
msgstr[1] ""
"*%s (AI)* Dostojíme spojenectví a vyhlásíme národu %s válku za %d tahy. "
"Vydržte, jsme na cestě!"
msgstr[2] ""
"*%s (AI)* Dostojíme spojenectví a vyhlásíme národu %s válku za %d tahů. "
"Vydržte, jsme na cestě!"

#: ai/default/daidiplomacy.c:1575
#, c-format
msgid ""
"*%s (AI)* We will honor our alliance with %s and declare war on %s in %d "
"turn.  We expect you to do likewise."
msgid_plural ""
"*%s (AI)* We will honor our alliance with %s and declare war on %s in %d "
"turns.  We expect you to do likewise."
msgstr[0] ""
"*%s (AI)* Dodržíme naše spojenectví s národem %s a vyhlásíme národu %s "
"válku za %d tah. Čekáme, že uděláte totéž."
msgstr[1] ""
"*%s (AI)* Dodržíme naše spojenectví s národem %s a vyhlásíme národu %s "
"válku za %d tahy. Čekáme, že uděláte totéž."
msgstr[2] ""
"*%s (AI)* Dodržíme naše spojenectví s národem %s a vyhlásíme národu %s "
"válku za %d tahů. Čekáme, že uděláte totéž."

#: ai/default/daidiplomacy.c:1656
#, c-format
msgid ""
"*%s (AI)* Your attempt to conquer space for yourself alone betrays your true "
"intentions, and I will have no more of our alliance!"
msgstr ""
"*%s (řízen počítačem)* Snažíte se obsadit vesmír pro sebe zrazujíce naše "
"skutečné cíle. Už nejsme spojenci!"

#: ai/default/daidiplomacy.c:1672
#, c-format
msgid ""
"*%s (AI)* Your attempt to unilaterally dominate outer space is highly "
"offensive."
msgstr "*%s (řízen počítačem)* Vaše snaha dobýt vesmír je velmi nepěkná."

#: ai/default/daidiplomacy.c:1676
#, c-format
msgid ""
"*%s (AI)* If you do not stop constructing your spaceship, I may be forced to "
"take action!"
msgstr ""
"*%s (řízen počítačem)* Jestli okamžitě nepřestanete stavět tu vesmírnou loď, "
"budeme nuceni přijmout patřičná opatření!"

#: ai/default/daidiplomacy.c:1798
#, c-format
msgid "*%s (AI)* Sorry, sharing vision with you is no longer safe."
msgstr ""
"*%s (řízen počítačem)* Lituji, ale sdílené vidění s Vámi už není bezpečné."

#: ai/default/daidiplomacy.c:1869
#, c-format
msgid ""
"*%s (AI)* Greetings our most trustworthy ally. We call upon you to destroy "
"our enemy, %s."
msgstr ""
"*%s (AI)* Zdravíme vás, nejvěrnější spojenci. Žádáme vás, abyste zničili "
"našeho nepřítele, národ %s."

#: ai/default/daidiplomacy.c:1877
#, c-format
msgid ""
"*%s (AI)* Greetings ally, I see you have not yet made war with our enemy, "
"%s. Why do I need to remind you of your promises?"
msgstr ""
"*%s (řízen počítačem)* Nazdar spojenče, vidím, že jsi ještě nevyhlásil válku "
"našim nepřátelům, %s. Proč Ti to musím připomínat?"

#: ai/default/daidiplomacy.c:1887
#, c-format
msgid ""
"*%s (AI)* Dishonored one, we made a pact of alliance, and yet you remain at "
"peace with our mortal enemy, %s! This is unacceptable; our alliance is no "
"more!"
msgstr ""
"*%s (AI)* Vy proradní! Uzavřeli jsme spojenectví, a přesto zůstáváte v "
"míru s naším úhlavním nepřítelem, národem %s! To je nepřijatelné. Naše "
"spojenectví končí!"

#: ai/default/daidiplomacy.c:1921
#, c-format
msgid ""
"*%s (AI)* Greetings friend, may we suggest making a common cause and join in "
"an alliance?"
msgstr ""
"*%s (AI)* Zdravíme vás, přátelé. Co kdybychom spojili síly a uzavřeli "
"spojenectví?"

#: ai/default/daidiplomacy.c:1938
#, c-format
msgid "*%s (AI)* Greetings neighbor, may we suggest more peaceful relations?"
msgstr ""
"*%s (AI)* Zdravíme vás, sousedé. Mohli bychom navázat pokojnější vztahy?"

#: ai/default/daidiplomacy.c:1955
#, c-format
msgid ""
"*%s (AI)* We grow weary of this constant bloodshed. May we suggest a "
"cessation of hostilities?"
msgstr ""
"*%s (AI)* Už jsme unavení neustálým krveprolitím. Co kdybychom ukončili "
"nepřátelství?"

#: ai/default/daidiplomacy.c:2243
#, c-format
msgid ""
"*%s (AI)* We have been savagely attacked by %s, and we need your help! Honor "
"our glorious alliance and your name will never be forgotten!"
msgstr ""
"*%s (AI)* Národ %s na nás surově zaútočil a potřebujeme vaši pomoc! "
"Dostojte našemu slavnému spojenectví a vaše jméno nikdy nebude zapomenuto!"

#: ai/difficulty.c:252
#| msgid "The AI will govern your nation but do minimal changes."
msgid ""
"Toggles 'away' mode for your nation. In away mode, the AI will govern your "
"nation but make only minimal changes."
msgstr ""
"Přepíná režim nepřítomnosti pro váš národ. V tomto režimu národ řídí AI a "
"provádí pouze nejnutnější změny."

#: ai/difficulty.c:258
#, c-format
msgid ""
"With no arguments, sets all AI players to skill level '%s', and sets the "
"default level for any new AI players to '%s'. With an argument, sets the "
"skill level for the specified player only."
msgstr ""
"Bez argumentů nastaví všem současným počítačovým hráčům obtížnost „%s“ a "
"novým hráčům výchozí obtížnost „%s“. S argumentem změní obtížnost jen "
"zadanému hráči."

#: ai/difficulty.c:276
msgid "Has erratic decision-making."
msgstr "Rozhoduje se nevyzpytatelně."

#: ai/difficulty.c:283
#, c-format
msgid "Research takes %d%% as long as usual."
msgstr "Výzkum trvá %d%% běžné doby."

#: ai/difficulty.c:287
msgid "Has reduced appetite for expansion."
msgstr "Má menší zájem o rozšiřování území."

#: ai/difficulty.c:294
msgid ""
"\n"
"This skill level has the same features as 'Novice', but may suffer "
"additional ruleset-defined penalties."
msgstr ""
"\n"
"Tato obtížnost má stejné vlastnosti jako „Začátečník“, ale sada pravidel "
"může přidat další postihy."

#: ai/difficulty.c:300
msgid ""
"\n"
"This skill level has the same features as 'Hard', but may enjoy additional "
"ruleset-defined bonuses."
msgstr ""
"\n"
"Tato obtížnost má stejné vlastnosti jako „Těžká“, ale sada pravidel může "
"přidat další bonusy."

#: ai/difficulty.c:309
msgid ""
"\n"
"This skill level's features include the following. (Some rulesets may define "
"extra level-specific behavior.)"
msgstr ""
"\n"
"Tato obtížnost má následující vlastnosti. Některé sady pravidel mohou pro "
"tuto úroveň přidat další změny chování."

#: ai/handicaps.c:86
msgid "Doesn't build offensive diplomatic units."
msgstr "Nestaví jednotky pro útočnou diplomacii."

#: ai/handicaps.c:90
#| msgid "Get sound sets from <%s>."
msgid "Gets reduced bonuses from huts."
msgstr "Získává menší odměny z chýší."

#: ai/handicaps.c:92
msgid "Prefers defensive buildings and avoids close diplomatic relations."
msgstr "Upřednostňuje obranné stavby a vyhýbá se úzkým diplomatickým vztahům."

#: ai/handicaps.c:95
msgid ""
"THIS IS ONLY FOR TESTING OF NEW AI FEATURES! For ordinary servers, this "
"level is no different to 'Hard'."
msgstr ""
"POUZE PRO TESTOVÁNÍ NOVÝCH FUNKCÍ AI! Na běžných serverech se tato úroveň "
"chová stejně jako „Těžká“."

#: ai/handicaps.c:99
msgid "Has no restrictions on tax rates."
msgstr "Sazby daní nemá omezené."

#: ai/handicaps.c:102
msgid "Can target units and cities in unseen or unexplored territory."
msgstr ""
"Může cílit na jednotky a města v území, které nevidí nebo neprozkoumal."

#: ai/handicaps.c:105
msgid "Knows the location of huts in unexplored territory."
msgstr "Zná polohu chýší v neprozkoumaném území."

#: ai/handicaps.c:108
msgid "Can see through fog of war."
msgstr "Vidí skrz válečnou mlhu."

#: ai/handicaps.c:110
#| msgid "Can't build a city."
msgid "Doesn't build air units."
msgstr "Nestaví letecké jednotky."

#: ai/handicaps.c:113
msgid "Has complete map knowledge, including unexplored territory."
msgstr "Zná celou mapu včetně neprozkoumaného území."

#: ai/handicaps.c:115
msgid "Naive at diplomacy."
msgstr "V diplomacii jedná naivně."

#: ai/handicaps.c:118
msgid "Can skip anarchy during revolution."
msgstr "Při revoluci může přeskočit období anarchie."

#: ai/handicaps.c:120
#| msgid "%s is not attached to any player."
msgid "Limits growth to match human players."
msgstr "Omezuje svůj růst na úroveň lidských hráčů."

#: ai/handicaps.c:122
msgid "Believes its cities are always under threat."
msgstr "Považuje svá města za trvale ohrožená."

#: ai/handicaps.c:124
msgid "Always offers cease-fire on first contact."
msgstr "Při prvním kontaktu vždy nabízí příměří."

#: ai/handicaps.c:126
msgid "Doesn't bribe worker or city founder units."
msgstr "Nepodplácí dělníky ani jednotky, které zakládají města."

#: ai/handicaps.c:129
msgid "Can change city production type without penalty."
msgstr "Může měnit typ výroby města bez postihu."

#: ai/handicaps.c:131
msgid "Limits the distance to search for threatening enemy units."
msgstr "Ohrožující nepřátelské jednotky hledá jen do určité vzdálenosti."

#: ai/tex/texai.c:593
msgid ""
"This Freeciv compilation has no full threads implementation, tex ai cannot "
"be used."
msgstr "Tato sestava Freeciv nemá plnou podporu vláken. AI tex nelze použít."

#: client/agents/cma_core.c:403 server/cityturn.c:424
#, c-format
msgid ""
"The citizen governor can't fulfill the requirements for %s. Passing back "
"control."
msgstr "Správce města %s nedokáže splnit požadavky. Vrací vám řízení."

#: client/agents/cma_core.c:412 client/agents/cma_core.c:432
#, c-format
msgid ""
"The citizen governor has gotten confused dealing with %s.  You may want to "
"have a look."
msgstr "Správce města %s si neví rady. Můžete zkontrolovat jeho nastavení."

#: client/agents/cma_fec.c:226 client/gui-gtk-3.22/cityrep.c:767
#: client/gui-gtk-3.22/cityrep.c:793 client/gui-gtk-4.0/cityrep.c:709
#: client/gui-gtk-4.0/cityrep.c:748
#| msgid "?cma:Governor"
msgid "?cma:none"
msgstr "?cma:žádný"

#: client/agents/cma_fec.c:242 client/gui-gtk-3.22/cityrep.c:814
#: client/gui-gtk-4.0/cityrep.c:776
#| msgid "custom"
msgid "?cma:custom"
msgstr "?cma:vlastní"

#. TRANS: city is not growing.  Keep short.
#. TRANS: city is not growing. Keep short.
#: client/agents/cma_fec.c:257 client/agents/cma_fec.c:291

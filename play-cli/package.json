{
  "name": "play-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Effect + Bun port of the player-only Freeciv session client",
  "bin": {
    "play": "./src/bin.ts"
  },
  "scripts": {
    "prepare": "effect-tsgo patch --oxlint",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "check": "bun run typecheck && bun run lint",
    "test": "bun test",
    "play": "bun run src/bin.ts"
  },
  "dependencies": {
    "@effect/cli": "^0.77.0",
    "@effect/platform": "^0.97.1",
    "@effect/platform-bun": "^0.91.2",
    "effect": "^3.22.1"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.2",
    "@effect/tsgo": "^0.36.4",
    "@types/bun": "^1.3.14",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7"
  }
}
